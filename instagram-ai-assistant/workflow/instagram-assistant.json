      "id": "wh-get",
      "name": "Webhook - Verification (GET)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-1200, -200],
      "webhookId": "instagram-spa-webhook-get"
    },
    {
      "parameters": {
        "jsCode": "// Meta calls this once when you subscribe the webhook.\n// Compare hub.verify_token against the value you set in the Meta App\n// AND in this node (or better: swap this literal for an n8n environment variable).\nconst VERIFY_TOKEN = 'REPLACE_WITH_YOUR_OWN_RANDOM_VERIFY_TOKEN';\n\nconst q = $json.query || {};\nconst mode = q['hub.mode'];\nconst token = q['hub.verify_token'];\nconst challenge = q['hub.challenge'];\n\nif (mode === 'subscribe' && token === VERIFY_TOKEN) {\n  return [{ json: { statusCode: 200, body: challenge } }];\n}\nreturn [{ json: { statusCode: 403, body: 'Verification failed' } }];"
      },
      "id": "code-verify-token",
      "name": "Check Verify Token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-980, -200]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{$json.body}}",
        "options": {
          "responseCode": "={{$json.statusCode}}"
        }
      },
      "id": "respond-verification",
      "name": "Respond - Verification",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [-760, -200]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "instagram-spa-webhook",
        "responseMode": "responseNode",
        "options": {
          "rawBody": true
        }
      },
      "id": "wh-post",
      "name": "Webhook - Events (POST)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-1200, 100],
      "webhookId": "instagram-spa-webhook-post"
    },
    {
      "parameters": {
        "jsCode": "// Validates Meta's X-Hub-Signature-256 header against the raw request body\n// using your Facebook App Secret. Requires 'Raw Body' enabled on the Webhook node.\nconst crypto = require('crypto');\n\nconst APP_SECRET = 'REPLACE_WITH_META_APP_SECRET'; // move to an n8n credential/env var in production\n\nconst signatureHeader = ($json.headers && ($json.headers['x-hub-signature-256'] || $json.headers['X-Hub-Signature-256'])) || '';\nconst rawBodyBase64 = $binary && $binary.data ? $binary.data.data : null;\n\nlet valid = false;\nif (rawBodyBase64) {\n  const rawBody = Buffer.from(rawBodyBase64, 'base64');\n  const expected = 'sha256=' + crypto.createHmac('sha256', APP_SECRET).update(rawBody).digest('hex');\n  try {\n    valid = crypto.timingSafeEqual(Buffer.from(expected), Buffer.from(signatureHeader));\n  } catch (e) {\n    valid = false;\n  }\n}\n\nreturn [{ json: { ...$json.body, __signatureValid: valid } }];"
      },
      "id": "code-verify-signature",
      "name": "Verify Signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-980, 100]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{$json.__signatureValid}}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-signature-valid",
      "name": "Signature Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-760, 100]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "Forbidden",
        "options": { "responseCode": 403 }
      },
      "id": "respond-forbidden",
      "name": "Respond - Forbidden",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [-540, 220]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "EVENT_RECEIVED",
        "options": { "responseCode": 200 }
      },
      "id": "respond-ack",
      "name": "Respond - Ack (200)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [-540, -20]
    },
    {
      "parameters": {
        "jsCode": "// Meta sends a payload with entry[].messaging[]. Extract the first real text message\n// and skip echoes (messages your own page sent), reads, deliveries, etc.\nconst body = $json;\nconst entry = (body.entry && body.entry[0]) || {};\nconst messaging = (entry.messaging && entry.messaging[0]) || {};\n\nconst isEcho = messaging.message && messaging.message.is_echo;\nconst text = messaging.message && messaging.message.text;\nconst senderId = messaging.sender && messaging.sender.id;\n\nif (!senderId || !text || isEcho) {\n  return [{ json: { hasText: false } }];\n}\n\nreturn [{ json: { hasText: true, senderId, text } }];"
      },
      "id": "code-parse-message",
      "name": "Parse Messaging Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-540, 160]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{$json.hasText}}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-has-text",
      "name": "Has Text Message?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-320, 160]
    },
    {
      "parameters": {},
      "id": "noop-ignore",
      "name": "Ignore (no text)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [-100, 280]
    },
    {
      "parameters": {
        "jsCode": "// Very simple keyword-based escalation guard. Tune this list as real conversations come in.\nconst ESCALATE_KEYWORDS = [\n  'complain', 'complaint', 'refund', 'angry', 'lawsuit', 'sue',\n  'allerg', 'pregnan', 'medical', 'injur', 'hurt', 'pain', 'reaction',\n  'human', 'person', 'manager', 'speak to someone',\n  'book', 'appointment', 'reservation', 'reschedule', 'cancel'\n];\n\nconst text = ($json.text || '').toLowerCase();\nconst matched = ESCALATE_KEYWORDS.find((kw) => text.includes(kw));\n\nreturn [{\n  json: {\n    senderId: $json.senderId,\n    text: $json.text,\n    escalate: Boolean(matched),\n    escalateReason: matched || null\n  }\n}];"
      },
      "id": "code-escalation-check",
      "name": "Escalation Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-100, 100]
