# Copy this file to .env.local and fill in your Supabase project's values.
# .env.local is gitignored — never commit real credentials.

# Project Settings > API in the Supabase dashboard.
# Safe to expose to the browser: every catalog table is public-read via RLS
# (see docs/DATABASE_SCHEMA.md §9), so the anon key can only do what RLS allows.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix this with NEXT_PUBLIC_ and never reference it from
# a Client Component — it bypasses RLS entirely. Used only by migration/seed
# scripts and any future server-only admin operation (see docs/ARCHITECTURE.md
# §3, "RLS from day one").
SUPABASE_SERVICE_ROLE_KEY=
